# Copy this file to ".env" and fill in your Supabase project credentials to
# switch Flexi from the built-in demo backend to a real backend.
#
# Find these in your Supabase project: Settings → API.
# Leave them blank (or delete .env) to keep running in local demo mode.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Embedded payroll provider. Leave blank to use the in-memory demo provider.
# No live provider is implemented yet (BIG-41), so setting this currently
# raises rather than silently falling back.
#
# Only the provider NAME belongs here. Payroll API keys must never use an
# EXPO_PUBLIC_ prefix: that inlines them into the shipped client bundle.
EXPO_PUBLIC_PAYROLL_PROVIDER=
